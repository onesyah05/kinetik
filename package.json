{
  "name": "kinetik-studio",
  "version": "0.4.1",
  "description": "AI video agent that writes Remotion scenes from a chat, checks its own frames and renders MP4s locally. Sign in with ChatGPT (Codex), Claude or Google (Antigravity).",
  "type": "module",
  "bin": {
    "kinetik": "bin/kinetik.mjs"
  },
  "files": [
    "bin",
    "cli",
    "kit",
    "server",
    "templates",
    "web",
    "vite.config.ts",
    "tsconfig.json",
    "requirements.txt",
    "Start-Kinetik.bat",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/onesyah05/kinetik.git"
  },
  "homepage": "https://github.com/onesyah05/kinetik#readme",
  "bugs": {
    "url": "https://github.com/onesyah05/kinetik/issues"
  },
  "keywords": [
    "ai",
    "video",
    "agent",
    "remotion",
    "text-to-video",
    "motion-graphics",
    "tiktok",
    "reels",
    "codex",
    "llm"
  ],
  "author": "onesyah05",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node bin/kinetik.mjs start --no-open",
    "dev": "tsx watch --exclude ./workspace --exclude ./data --exclude ./web server/index.ts",
    "cli": "node bin/kinetik.mjs cli",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke-test.ts",
    "mock-llm": "tsx scripts/mock-llm.ts"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@remotion/bundler": "^4.0.541",
    "@remotion/google-fonts": "^4.0.541",
    "@remotion/noise": "^4.0.541",
    "@remotion/paths": "^4.0.541",
    "@remotion/player": "^4.0.541",
    "@remotion/renderer": "^4.0.541",
    "@remotion/shapes": "^4.0.541",
    "@remotion/transitions": "^4.0.541",
    "@resvg/resvg-js": "^2.6.2",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.69.0",
    "multer": "^2.5.0",
    "openai": "^7.52.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.541",
    "tsx": "^4.23.15",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
